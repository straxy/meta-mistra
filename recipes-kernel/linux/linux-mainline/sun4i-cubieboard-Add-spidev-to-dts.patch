From d04db08e367cd482af625c99edbc6bcb1b8ea980 Mon Sep 17 00:00:00 2001
From: Strahinja Jankovic <strahinja.p.jankovic@gmail.com>
Date: Tue, 1 Jul 2025 19:33:04 +0200
Subject: [PATCH] sun4i-cubieboard: Add spidev to dts

Signed-off-by: Strahinja Jankovic <strahinja.p.jankovic@gmail.com>
---
 arch/arm/boot/dts/allwinner/sun4i-a10-cubieboard.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm/boot/dts/allwinner/sun4i-a10-cubieboard.dts b/arch/arm/boot/dts/allwinner/sun4i-a10-cubieboard.dts
index 0645d6064..f71142432 100644
--- a/arch/arm/boot/dts/allwinner/sun4i-a10-cubieboard.dts
+++ b/arch/arm/boot/dts/allwinner/sun4i-a10-cubieboard.dts
@@ -234,6 +234,11 @@ &spi0 {
 	pinctrl-0 = <&spi0_pi_pins>,
 		    <&spi0_cs0_pi_pin>;
 	status = "okay";
+	spidev@0{
+		compatible = "rohm,dh2228fv";
+		reg = <0>;
+		spi-max-frequency = <4000000>;
+	};
 };
 
 &uart0 {
